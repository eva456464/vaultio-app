# Build settings for the published plugin (copy to .env.local).
# Name shown in Framer and the plugin panel.
VITE_BRAND_NAME=Vaultio
# The app's content API (Settings → Publishing → API shows it). Clients on an agency's own domain can
# change it in the plugin under "API address".
VITE_API_BASE=https://app.vaultio.co/api/integrations
