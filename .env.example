# Postgres connection (Supabase, Neon, RDS or local)
DATABASE_URL=postgres://postgres@localhost:5432/vaultio

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google: the Analytics / Search Console connection, and Google sign-in.
# One Google Cloud OAuth client ("Web application") serves both. Authorized redirect URIs:
#   <APP_URL>/api/integrations/google/callback   Analytics + Search Console
#   <BETTER_AUTH_URL>/api/auth/callback/google    Google sign-in (shown once these are set)
# Enable the Google Analytics Data API, Google Analytics Admin API and Google Search Console API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: send every Google call to scripts/dev-fixtures/mock-google.py
# GOOGLE_API_MOCK_URL=http://localhost:4400

# Brand used when the request host has no white-label config (quote the colour: an unquoted # starts a comment)
DEFAULT_BRAND_NAME=Vaultio
DEFAULT_BRAND_COLOR="#E94545"

# Public address of the app (falls back to BETTER_AUTH_URL). Used in email links and in article image
# URLs (/media/...), so in production it must be reachable by client websites.
APP_URL=http://localhost:3000

# Agents: writing, brand profile, AI prompts (Claude)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Agents: keyword volumes, competitors, SERPs, domain rating (DataForSEO)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Encrypts integration credentials at rest (64 hex chars, e.g. `openssl rand -hex 32`).
# Falls back to a key derived from BETTER_AUTH_SECRET when unset.
APP_ENCRYPTION_KEY=

# OpenAI and Gemini: ChatGPT / Gemini answers for AI visibility, and article images (see below)
OPENAI_API_KEY=
# OPENAI_VISIBILITY_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_VISIBILITY_MODEL=gemini-2.5-flash

# Article images (cover + body) use the same keys: OpenAI when OPENAI_API_KEY is set (best at lettering
# for the "with title" styles), otherwise Gemini. Without either, articles are published without images.
# IMAGE_PROVIDER=openai             # or google, to force one
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium       # low | medium | high
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Reddit thread details (votes, comments, age, archived/locked) for the Reddit agent. Optional: without it
# threads show what the search found. Create a "script"/"web" app at https://www.reddit.com/prefs/apps;
# commercial use of Reddit's Data API needs Reddit's approval.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=                  # the Reddit account that owns the app (sent in the User-Agent)

# Billing (Stripe). Without STRIPE_SECRET_KEY nothing is billed and every agent runs.
# Run `npx tsx --tsconfig tsconfig.json scripts/stripe-setup.ts` once to create the products and prices
# (amounts in scripts/stripe-prices.json), then add a webhook endpoint for /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# BILLING_TRIAL_DAYS=3              # free trial on a website's first plan; 0 for none
# STRIPE_API_BASE=http://localhost:4600   # development only: scripts/dev-fixtures/mock-stripe.py

# Sender for invitations and invoice emails (falls back to REPORT_FROM_EMAIL)
# EMAIL_FROM="Vaultio <hello@vaultio.co>"

# Monthly client report emails (Resend: https://resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=
REPORT_FROM_EMAIL=
